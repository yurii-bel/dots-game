# PostgreSQL
POSTGRES_USER=dots
POSTGRES_PASSWORD=dots
POSTGRES_DB=dots
DATABASE_URL=postgresql://dots:dots@localhost:5432/dots?schema=public

# Apps
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
SERVER_PORT=4000
WEB_PORT=3000
NODE_ENV=development

# Clerk (placeholders — Yurii supplies real keys via env, not chat)
# Dashboard: Email+password + Google only; webhook → /api/webhooks/clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder
# Optional PEM JWT public key for networkless verify on the game server
# (Clerk Dashboard → API keys → Show JWT public key)
CLERK_JWT_KEY=
# Comma-separated origins allowed in JWT azp (defaults to NEXT_PUBLIC_APP_URL)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Optional Clerk frontend paths (defaults match apps/web routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
