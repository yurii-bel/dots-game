// Milestone 4 + auth: lean Game / GamePlayer / Move + Clerk User.
// Active gameplay state remains in-memory on the Socket.IO server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder retained from M1 scaffold.
model HealthCheck {
  id        String   @id @default(cuid())
  note      String   @default("scaffold")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

/// Clerk-backed account. Nickname is null until onboarding.
model User {
  id                 String   @id @default(cuid())
  clerkId            String   @unique @map("clerk_id")
  email              String?  @unique
  nickname           String?
  nicknameNormalized String?  @unique @map("nickname_normalized")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  gamePlayers   GamePlayer[]
  ratings       Rating[]
  rankedAsLow   RankedResult[] @relation("RankedLow")
  rankedAsHigh  RankedResult[] @relation("RankedHigh")

  @@map("users")
}

/// Classical (v1) Elo row — one per user per pool.
model Rating {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  /// v1: "classical" only.
  pool         String    @default("classical")
  rating       Int       @default(1200)
  gamesPlayed  Int       @default(0) @map("games_played")
  /// Permanent Classical title: N | 3 | 2 | 1 | C | M | H | G
  title        String    @default("N")
  lastRankedAt DateTime? @map("last_ranked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pool])
  @@index([pool, rating(sort: Desc)])
  @@map("ratings")
}

/// Audit row for a ranked Find-match result (private rooms are unranked in v1).
model RankedResult {
  id             String   @id @default(cuid())
  gameId         String   @unique @map("game_id")
  pool           String   @default("classical")
  /// Lexicographically lower user id (stable pair key).
  userLowId      String   @map("user_low_id")
  /// Lexicographically higher user id.
  userHighId     String   @map("user_high_id")
  winnerColor    String?  @map("winner_color")
  ratingBeforeLow  Int    @map("rating_before_low")
  ratingAfterLow   Int    @map("rating_after_low")
  ratingBeforeHigh Int    @map("rating_before_high")
  ratingAfterHigh  Int    @map("rating_after_high")
  scoreLow       Float    @map("score_low")
  tradeFactor    Float    @default(1) @map("trade_factor")
  createdAt      DateTime @default(now()) @map("created_at")

  game     Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userLow  User @relation("RankedLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("RankedHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@index([userLowId, userHighId, createdAt])
  @@index([createdAt])
  @@map("ranked_results")
}

enum GameStatus {
  waiting
  in_progress
  finished

  @@map("game_status")
}

enum PlayerColor {
  blue
  red

  @@map("player_color")
}

model Game {
  id             String     @id @default(cuid())
  /// Short code for private room join (nullable for matchmaking games).
  roomCode       String?    @unique @map("room_code")
  /// Find-match games are ranked; private rooms are unranked in v1.
  ranked         Boolean    @default(false)
  status         GameStatus @default(waiting)
  ruleset        String     @default("classic")
  rulesetVersion String     @default("2017.1") @map("ruleset_version")
  /// Engine moveNumber / optimistic concurrency version.
  version        Int        @default(0)
  winnerColor    PlayerColor? @map("winner_color")
  finishedReason String?    @map("finished_reason")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  players      GamePlayer[]
  moves        Move[]
  rankedResult RankedResult?

  @@index([status])
  @@index([ranked, status])
  @@map("games")
}

model GamePlayer {
  id          String      @id @default(cuid())
  gameId      String      @map("game_id")
  playerId    String      @map("player_id")
  /// Prisma User id when the seat is bound to an authenticated account.
  userId      String?     @map("user_id")
  color       PlayerColor
  displayName String?     @map("display_name")
  createdAt   DateTime    @default(now()) @map("created_at")

  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([gameId, color])
  @@unique([gameId, playerId])
  @@index([playerId])
  @@index([userId])
  @@map("game_players")
}

model Move {
  id         String   @id @default(cuid())
  gameId     String   @map("game_id")
  moveNumber Int      @map("move_number")
  playerId   String   @map("player_id")
  x          Int
  y          Int
  requestId  String   @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, moveNumber])
  @@unique([gameId, x, y])
  @@unique([gameId, requestId])
  @@index([gameId])
  @@map("moves")
}
